<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet id="1" author="antigravity">
        <createTable tableName="upi_transactions">
            <column name="transaction_id" type="VARCHAR2(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_vpa" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="merchant_vpa" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMBER(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="event_timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="retry_count" type="INT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_upi_customer_vpa" tableName="upi_transactions">
            <column name="customer_vpa"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
